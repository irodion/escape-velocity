{
  "name": "escape-velocity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "wasm:build": "rustup run nightly-2025-11-15 wasm-pack build ../crates/fractal-wasm --target web --out-dir ../../web/wasm --release",
    "dev": "pnpm wasm:build && vite",
    "build": "pnpm wasm:build && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm wasm:build && tsc --noEmit",
    "typecheck:only": "tsc --noEmit",
    "test": "pnpm wasm:build && vitest run",
    "test:only": "vitest run",
    "lint": "biome ci",
    "fmt": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "jsdom": "^29.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7"
  }
}
