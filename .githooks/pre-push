#!/usr/bin/env bash
#
# Block pushes that update the protected `main` branch.
#
# Git feeds one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# We reject the push if any <remote ref> targets refs/heads/main.
#
# Escape hatch (for an explicitly user-approved push):
#   ALLOW_MAIN_PUSH=1 git push origin main
#
set -euo pipefail

protected="refs/heads/main"

if [[ "${ALLOW_MAIN_PUSH:-0}" == "1" ]]; then
  echo "pre-push: ALLOW_MAIN_PUSH=1 set — permitting push to main." >&2
  exit 0
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "$protected" ]]; then
    cat >&2 <<'MSG'
✋ pre-push blocked: pushing to `main` is not allowed.

Work goes through a feature branch + PR. If a direct push to main is
genuinely intended and the user has approved it, re-run with:

    ALLOW_MAIN_PUSH=1 git push origin main

MSG
    exit 1
  fi
done

exit 0
